---
interface Props {
  title: string;
  lead?: string;
  tone?: "brand" | "light";
  compact?: boolean;
  image?: ImageMetadata;
  titleBreakAfter?: string;
}

import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
const { title, lead, tone = "light", compact = false, image = null, titleBreakAfter } = Astro.props;
const breakIndex = titleBreakAfter ? title.indexOf(titleBreakAfter) + titleBreakAfter.length : -1;
---

<section class:list={["page-hero", `page-hero--${tone}`, { "page-hero--compact": compact }]} aria-labelledby="page-title">
  <div class="shell page-hero-grid">
    <div>
      <h1 id="page-title">{breakIndex > 0 ? <>{title.slice(0, breakIndex)}<wbr />{title.slice(breakIndex)}</> : title}</h1>
      {lead && <p class="lead">{lead}</p>}
      <div class="hero-actions"><slot name="actions" /></div>
    </div>
    <div class:list={["hero-aside", { "hero-aside--image": image }]}>
      {image && <Image src={image} alt="" widths={[480, 720, 960, 1280, 1600]} sizes="(min-width: 52rem) 34vw, 100vw" loading="eager" decoding="async" />}
      <slot name="aside" />
    </div>
  </div>
</section>

<style>
  .page-hero {
    overflow: clip;
    padding-block: clamp(4.5rem, 10vw, 8rem);
  }

  .page-hero--compact { padding-block: clamp(2.75rem, 6vw, 4.5rem); }
  .page-hero--compact.page-hero--light { border-bottom: 1px solid var(--color-line); background: var(--color-background); }
  .page-hero--compact h1 { max-width: 24ch; font-size: clamp(2.35rem, 6vw, 4.25rem); line-height: 1; }
  .page-hero--compact .lead { font-size: 1.12rem; margin-top: 1rem; }

  .page-hero--brand {
    position: relative;
    color: white;
    background:
      radial-gradient(circle at 90% 15%, rgb(61 255 208 / 28%), transparent 28rem),
      linear-gradient(140deg, var(--color-brand-dark), var(--color-brand) 62%, #6a2cff);
  }

  .page-hero--light {
    background:
      radial-gradient(circle at 85% 10%, rgb(82 0 255 / 13%), transparent 24rem),
      var(--color-background);
  }

  .page-hero-grid { display: grid; min-width: 0; grid-template-columns: minmax(0, 1fr); gap: 2.5rem; align-items: center; }
  .page-hero-grid > * { min-width: 0; }

  h1 {
    max-width: 13ch;
    overflow-wrap: break-word;
    word-break: normal;
    hyphens: auto;
    margin: 0;
    color: inherit;
    font-size: var(--font-size-hero);
    font-weight: 950;
    letter-spacing: -0.052em;
    line-height: 0.95;
  }

  .page-hero--light h1 { color: var(--color-ink); }

  .lead {
    max-width: 42rem;
    margin: 1.6rem 0 0;
    color: inherit;
    font-size: var(--font-size-lead);
    opacity: 0.84;
  }

  .page-hero--light .lead { color: var(--color-muted); opacity: 1; }
  .hero-actions:empty,
  .hero-aside:empty { display: none; }
  .hero-aside--image { overflow: hidden; border-radius: 1.25rem; aspect-ratio: 4 / 3; box-shadow: 0 1.25rem 3rem rgb(19 11 56 / 16%); }
  .hero-aside--image img { width: 100%; height: 100%; display: block; object-fit: cover; }
  .page-hero--brand .hero-aside--image { border: 1px solid rgb(255 255 255 / 32%); }
  .hero-actions { margin-top: 2rem; }

  @media (min-width: 52rem) {
    .page-hero-grid:has(.hero-aside:not(:empty)) { grid-template-columns: minmax(0, 1.45fr) minmax(17rem, 0.75fr); }
  }

  @media (prefers-reduced-motion: reduce) { .hero-aside--image { scroll-behavior: auto; } }
</style>
