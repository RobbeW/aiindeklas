---
import type { SiteLocale } from "../lib/routing";

interface Props { lang: SiteLocale; }
const { lang } = Astro.props;
const english = lang === "en";
---

<section id="privacy-notice" class="privacy-notice" aria-labelledby="privacy-notice-title">
  <div class="privacy-notice__inner shell">
    <div>
      <h2 id="privacy-notice-title">{english ? "Privacy and cookies" : "Privacy en cookies"}</h2>
      <p>{english
        ? "This site deliberately uses no cookies, analytics or other tracking tools. I value your online privacy. Enjoy!"
        : "Deze site gebruikt bewust geen cookies, analytics of andere tracking tools. Ik waardeer jouw online privacy. Enjoy!"}</p>
    </div>
  </div>
</section>

<style>
  .privacy-notice {
    border-top: 1px solid var(--color-line);
    background: var(--color-surface);
    box-shadow: none;
  }
  .privacy-notice__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    padding-block: 1rem;
  }
  .privacy-notice__inner > div { max-width: 65rem; }
  h2 { margin: 0 0 0.35rem; color: var(--color-ink); font-size: 1.1rem; }
  p { margin: 0; color: var(--color-muted); }
</style>
