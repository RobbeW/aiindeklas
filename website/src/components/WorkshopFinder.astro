---
import { readFileSync } from "node:fs";
import { resolve } from "node:path";
import { getCollection } from "astro:content";
import { getImage } from "astro:assets";
import type { ImageMetadata } from "astro";
import { parse } from "yaml";
import { withBase } from "../lib/routing";
import { buildWorkshopCatalogue } from "../lib/workshop-finder.mjs";
import { resolveWorkshopThumbnail } from "../lib/workshop-thumbnails.mjs";
import WorkshopExperience from "./workshop/WorkshopExperience";

interface Workshop {
  id: string;
  title: string;
  slug: string;
  hero?: string | { id: string } | null;
  seo?: { image?: string | { id: string } | null; canonical_path?: string | null };
  [key: string]: unknown;
}
interface Props { workshops: Workshop[]; }

const { workshops } = Astro.props;
const catalogueBrief = parse(readFileSync(resolve(process.cwd(), "docs/client_onboarding_workshop_finder.yaml"), "utf8"));
const designBrief = parse(readFileSync(resolve(process.cwd(), "../docs/workshop_onboarding_shadcn_prompt.yaml"), "utf8"));
const [articles, projects, media] = await Promise.all([
  getCollection("articles"),
  getCollection("projects"),
  getCollection("media"),
]);
const verifiedRoutes = [...new Set([
  ...workshops.map((record) => record.seo?.canonical_path),
  ...articles.map((record) => record.data.seo.canonical_path),
  ...projects.map((record) => record.data.seo.canonical_path),
].filter((route): route is string => Boolean(route)))];

const catalogue = (buildWorkshopCatalogue as any)({
  catalogueBrief,
  designBrief,
  workshops,
  articles,
  projects,
  verifiedRoutes,
});

const mediaById = new Map(media.map((record) => [record.id, record.data]));
const migratedImages = import.meta.glob<{ default: ImageMetadata }>("../assets/migrated/**/*.{avif,gif,jpeg,jpg,png,webp}", { eager: true });
const workshopThumbnails = import.meta.glob<{ default: ImageMetadata }>("../assets/workshop-thumbnails/*.{avif,jpeg,jpg,png,webp}", { eager: true });
const imageFor = async (offer: any) => {
  const thumbnail = resolveWorkshopThumbnail(offer, workshopThumbnails);
  if (thumbnail?.default) {
    const source = thumbnail.default;
    const rendered = await getImage({ src: source, width: Math.min(source.width, 960), format: "webp" });
    return { src: rendered.src, alt: offer.title };
  }
  const reference = offer.image;
  const id = typeof reference === "string" ? reference : reference?.id;
  const record = id ? mediaById.get(id) : null;
  if (!record || !record.mime_type.startsWith("image/")) return null;
  const importPath = record.output_path.replace(/^src\/assets\//, "../assets/");
  const source = migratedImages[importPath]?.default;
  if (!source) return null;
  const rendered = await getImage({ src: source, width: Math.min(source.width, 960), format: "webp" });
  return { src: rendered.src, alt: record.alt ?? offer.title };
};
const baseSourceHtml = (html: string) => html.replace(/href="(\/(?!\/)[^"]*)"/g, (_match, href) => `href="${withBase(href)}"`);

const offers = await Promise.all(catalogue.offers.map(async (offer: any) => {
  const source = offer.source ?? {};
  return {
    ...offer,
    image: await imageFor(offer),
    related: (catalogue.relatedFor(offer) ?? []).slice(0, 2).map((item: any) => ({ ...item, route: withBase(item.route) })),
    source: {
      id: source.id,
      title: source.title,
      summary: source.summary,
      programme: source.programme,
      target_audience: source.target_audience,
      duration_display: source.duration_display,
      workshop_type: source.workshop_type,
      location_notes: source.location_notes,
      sourceDetails: (source.sourceDetails ?? source.source_details ?? []).map((detail: any) => ({
        heading: detail.heading,
        html: baseSourceHtml(detail.html),
      })),
    },
  };
}));

const approvedQuestionById = new Map((designBrief.onboarding?.questions ?? []).map((question: any) => [question.id, question]));
const questionSources = [
  ["persona", catalogueBrief.onboarding_questions.q1_persona],
  ["need", catalogueBrief.onboarding_questions.q2_need],
  ["subject", catalogueBrief.onboarding_questions.q2b_subject],
  ["duration", catalogueBrief.onboarding_questions.q3_duration],
  ["groupSize", catalogueBrief.onboarding_questions.q4_group_size],
] as const;
const questions = questionSources.map(([id, source]) => {
  const approved = approvedQuestionById.get(id === "groupSize" ? "group_size" : id) as any;
  const approvedChoices = new Map((approved?.choices ?? []).map((choice: any) => [choice.value, choice]));
  return {
    id,
    prompt: approved?.prompt ?? source.prompt,
    conditionalNeed: id === "subject" ? "vakspecifiek" : null,
    options: source.options.map((option: any) => {
      const approvedChoice = approvedChoices.get(option.id) as any;
      return {
        id: option.id,
        label: approvedChoice?.label ?? option.label,
        description: approvedChoice?.description ?? option.note ?? `Kies ${String(option.label).toLowerCase()}.`,
      };
    }),
  };
});

const data = {
  offers,
  questions,
  categoryLabels: Object.fromEntries(Object.entries(catalogueBrief.categories).map(([id, value]: [string, any]) => [id, value.label])),
  subcategoryLabels: Object.fromEntries(Object.entries(catalogueBrief.categories.vakspecifieke_professionalisering.subcategories).map(([id, value]: [string, any]) => [id, value.label])),
  ranking: {
    onboarding_questions: catalogueBrief.onboarding_questions,
    personas: catalogueBrief.personas,
    recommendation_logic: catalogueBrief.recommendation_logic,
    result_page: catalogueBrief.result_page,
  },
};
---

<section class="section shell finder-section" aria-labelledby="offer-heading">
  <div class="finder-intro">
    <h2 id="offer-heading">Kies een sessie die past bij je vraag</h2>
    <p>Beantwoord enkele korte vragen. Je krijgt maximaal drie sessies uit het bestaande aanbod.</p>
  </div>
  <WorkshopExperience client:load data={data} contactHref={withBase("/contact")} />
  <noscript><p>JavaScript is nodig voor de interactieve keuzehulp. Je kan je vraag ook rechtstreeks via de contactpagina bespreken.</p></noscript>
</section>

<style>
  .finder-section { display: grid; gap: 2rem; }
  .finder-intro { max-width: var(--content-readable); }
  .finder-intro h2 { color: var(--color-ink); margin-bottom: .5rem; }
  .finder-intro p { color: var(--color-muted); }
</style>
