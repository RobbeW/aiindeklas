---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getImage } from "astro:assets";
import type { DocumentViewModel } from "../lib/content-view";
import { shouldIndexRoute } from "../lib/discoverability";

interface Props {
  content: DocumentViewModel;
  canonicalPath?: string;
}

const { content, canonicalPath = "/" } = Astro.props;
const noindex = !shouldIndexRoute({ status: content.status, migration_status: content.migrationStatus, seo: { noindex: content.noindex, canonical_path: canonicalPath } }, import.meta.env.PUBLIC_INDEXING_ENABLED === "true");
const socialImage = content.socialImage ? (await getImage({ src: content.socialImage })).src : null;
---

<SiteLayout
  title={`${content.title} — Robbe Wulgaert`}
  description={content.description}
  lang="nl-BE"
  canonicalPath={canonicalPath}
  noindex={noindex}
  alternatePath="/about"
  hasDirectTranslation={true}
  sourceHome={true}
  image={socialImage}
>
  <main id="main-content" tabindex="-1" data-content-collection={content.collection} data-content-id={content.id}>
    <section class="home-introduction" aria-label="Introductie">
      <div class="shell source-home"><slot /></div>
    </section>
  </main>
</SiteLayout>

<style>
  :global(body) { background: var(--color-surface); }

  .home-introduction { padding-block: clamp(2.5rem, 6vw, 5.75rem); }

  .source-home {
    width: min(calc(100% - (2 * var(--page-gutter))), 79.375rem);
    display: grid;
    gap: 1.4rem;
  }

  :global(html), :global(body) { overflow-x: clip; }
  .source-home :global(.home-block) { min-width: 0; hyphens: none; }
  .source-home :global(.home-block--work), .source-home :global(.home-block--education) { max-width: 48rem; }
  .source-home :global(.home-block--hero) { display: grid; gap: 1.4rem; }
  .source-home :global(.home-block--book) { display: grid; gap: 1.4rem; }
  .source-home :global(.home-action) { margin-block: 0; }
  .source-home :global(.home-actions) { display: grid; gap: .75rem; }
  .source-home :global(.home-actions .content-button) { width: 100%; }

  .source-home :global(h1) {
    max-width: none;
    margin: 0;
    color: var(--color-brand);
    font-size: clamp(3rem, 5vw, 4.1rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .source-home :global(p) {
    margin: 0;
    color: var(--color-brand-dark);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.78;
  }

  .source-home :global(p > a:has(img)) {
    display: block;
    color: inherit;
  }

  .source-home :global(img) {
    width: 100%;
    border-radius: 0;
  }

  .source-home :global(.home-block--hero img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .source-home :global(.home-block--book img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% center;
  }

  .source-home :global(.content-button-row) { margin: 0; }

  @media (min-width: 56rem) {
    .source-home {
      gap: clamp(2rem, 4vw, 4rem);
    }

    .source-home :global(.home-block--hero) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }
    .source-home :global(.home-block--hero h1) { align-self: end; }
    .source-home :global(.home-block--book) { grid-template-columns: minmax(0, .72fr) minmax(0, 1fr); align-items: start; }
    .source-home :global(.home-block--book .home-actions) { grid-column: 2; align-self: start; }
    .source-home :global(.home-block--book img) { grid-row: 1 / span 3; }

    .source-home :global(.home-block--book img) { aspect-ratio: 0.72; }
  }

</style>
