---
import PageHero from "./PageHero.astro";
import PreviewNotice from "./PreviewNotice.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase, type SiteLocale } from "../lib/routing";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { shouldIndexPath } from "../lib/route-policy";

export interface ListingCard {
  id: string;
  title: string;
  description: string;
  href: string;
  meta?: string | null;
  external?: boolean;
  image?: ImageMetadata | null;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  locale: SiteLocale;
  canonicalPath: string;
  eyebrow: string;
  cards: ListingCard[];
  alternatePath?: string | null;
  thematicLinks?: Array<{ label: string; href: string }>;
  archiveHref?: string | null;
  countLabel?: string;
}

const {
  title,
  seoTitle = title,
  description,
  locale,
  canonicalPath,
  eyebrow,
  cards,
  alternatePath = null,
  thematicLinks = [],
  archiveHref = null,
  countLabel = locale === "en" ? "entries" : "items"
} = Astro.props;
const hrefFor = (card: ListingCard) => card.external ? card.href : withBase(card.href);
---

<SiteLayout
  title={`${seoTitle} — Robbe Wulgaert`}
  description={description}
  lang={locale}
  canonicalPath={canonicalPath}
  noindex={!shouldIndexPath(canonicalPath, import.meta.env.PUBLIC_INDEXING_ENABLED === "true")}
  alternatePath={alternatePath}
  hasDirectTranslation={Boolean(alternatePath)}
>
  <main id="main-content" tabindex="-1">
    <PageHero eyebrow={eyebrow} title={title} lead={description} compact />
    <section class="section shell listing-layout" aria-labelledby="listing-heading">
      <PreviewNotice lang={locale} />
      <div class="intro prose"><slot /></div>
      {thematicLinks.length > 0 && <nav class="theme-links" aria-label={locale === "en" ? "Explore topics" : "Thema's ontdekken"}>
        <h2 class="section-heading">{locale === "en" ? "Explore by topic" : "Ontdek per thema"}</h2>
        <div class="theme-grid">{thematicLinks.map((theme) => <a class="theme-link" href={withBase(theme.href)}>{theme.label}</a>)}</div>
      </nav>}
      <div class="listing-header">
        <h2 id="listing-heading" class="section-heading">
          {cards.length} {countLabel}
        </h2>
        {archiveHref && <a href={withBase(archiveHref)}>{locale === "en" ? "Complete archive" : "Volledig archief"}</a>}
      </div>
      {cards.length > 0 ? (
        <div class="listing-grid">
          {cards.map((card) => (
            <article class:list={["listing-card", { "listing-card--with-image": Boolean(card.image) }]} id={card.id}>
              <a class:list={["listing-card-link", { "listing-card-link--with-image": Boolean(card.image) }]} href={hrefFor(card)}>
              {card.image && (
                <span class="listing-image" aria-hidden="true">
                  <Image
                    src={card.image}
                    alt=""
                    widths={[320, 640, 960]}
                    sizes="(max-width: 42rem) 100vw, 32vw"
                    loading="lazy"
                    decoding="async"
                  />
                </span>
              )}
              <div class="listing-copy">
                {card.meta && <p class="listing-meta">{card.meta}</p>}
                <h3>{card.title}</h3>
                <p>{card.description}</p>
              </div>
              </a>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">{locale === "en" ? "No articles match these topics yet." : "Er zijn momenteel geen artikels voor deze thema's."}</p>
      )}
    </section>
  </main>
</SiteLayout>

<style>
  .listing-layout { display: grid; gap: 2.25rem; }
  .intro:empty { display: none; }
  .prose { max-width: var(--content-readable); font-size: 1.06rem; }
  .prose :global(img) { border-radius: var(--radius-card); }
  .listing-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .listing-grid { display: grid; gap: 1rem; }
  .listing-card { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); padding: clamp(1.25rem, 3vw, 1.8rem); box-shadow: var(--shadow-card); }
  .listing-card--with-image { padding: 0; }
  .listing-image { min-height: 12rem; overflow: hidden; background: var(--color-brand-soft); }
  .listing-image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--motion-medium) var(--ease-standard); }
  .listing-image:hover img { transform: scale(1.025); }
  .listing-copy { align-self: center; padding: clamp(1.25rem, 3vw, 1.8rem); }
  .listing-card h3 { margin: 0; color: var(--color-ink); font-size: clamp(1.15rem, 3vw, 1.4rem); }
  .listing-card h3 a { color: inherit; text-decoration-thickness: 0.09em; text-underline-offset: 0.18em; }
  .listing-card-link { display: block; color: inherit; text-decoration: none; }
  .listing-card-link--with-image { display: grid; grid-template-columns: minmax(11rem, 0.72fr) minmax(0, 1.6fr); }
  .listing-card-link:focus-visible { outline: 3px solid var(--color-focus-dark); outline-offset: -3px; border-radius: inherit; box-shadow: inset 0 0 0 3px var(--color-focus-light); }
  .theme-links { display: grid; gap: 1rem; }
  .theme-grid { display: flex; flex-wrap: wrap; gap: .65rem; }
  .theme-link { border: 1px solid var(--color-line); border-radius: var(--radius-card); padding: .65rem .9rem; color: var(--color-brand); font-weight: 750; }
  .listing-copy > p:last-child { max-width: 65ch; margin-bottom: 0; color: var(--color-muted); }
  .listing-meta { margin: 0 0 0.6rem; color: var(--color-brand); font-size: 0.83rem; font-weight: 850; letter-spacing: 0.04em; text-transform: uppercase; }
  .empty-state { border: 1px dashed var(--color-line); border-radius: var(--radius-card); padding: 1.5rem; color: var(--color-muted); }
  @media (max-width: 42rem) {
    .listing-card-link--with-image { grid-template-columns: 1fr; }
    .listing-image { min-height: 0; aspect-ratio: 16 / 9; }
  }
</style>
