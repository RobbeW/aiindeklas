---
import "../styles/global.css";
import { normaliseLogicalPath, withBase, withoutBase, type SiteLocale } from "../lib/routing";

interface TranslationLink {
  lang: SiteLocale;
  path: string;
}

interface Props {
  title: string;
  description: string;
  lang?: SiteLocale;
  canonicalPath?: string;
  noindex?: boolean;
  translationLinks?: TranslationLink[];
  image?: string | null;
  ogType?: "website" | "article";
  publishedAt?: string | null;
  modifiedAt?: string | null;
}

const {
  title,
  description,
  lang = "nl-BE",
  canonicalPath = withoutBase(Astro.url.pathname),
  noindex = false,
  translationLinks = [],
  image = null,
  ogType = "website",
  publishedAt = null,
  modifiedAt = null
} = Astro.props;

const logicalCanonical = normaliseLogicalPath(canonicalPath);
const canonical = new URL(withBase(logicalCanonical), Astro.site);
const allowIndexing = import.meta.env.PUBLIC_INDEXING_ENABLED === "true" && !noindex;
const robots = allowIndexing ? "index, follow, max-image-preview:large" : "noindex, nofollow";
const socialImage = image ? new URL(withBase(image), Astro.site) : null;
const ogLocale = lang === "en" ? "en_US" : "nl_BE";
const feedPath = lang === "en" ? "/education/rss.xml" : "/onderwijs/rss.xml";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#5200ff" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={withBase("/favicon.svg")} type="image/svg+xml" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="application/rss+xml" title={lang === "en" ? "Education articles" : "Onderwijsartikels"} href={new URL(withBase(feedPath), Astro.site)} />
    {translationLinks.map((translation) => (
      <link rel="alternate" hreflang={translation.lang} href={new URL(withBase(translation.path), Astro.site)} />
    ))}
    {translationLinks.length > 0 && (
      <link rel="alternate" hreflang="x-default" href={new URL(withBase("/"), Astro.site)} />
    )}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Robbe Wulgaert" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {ogType === "article" && publishedAt && <meta property="article:published_time" content={publishedAt} />}
    {ogType === "article" && modifiedAt && <meta property="article:modified_time" content={modifiedAt} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{lang === "en" ? "Skip to content" : "Ga naar de inhoud"}</a>
    <slot />
  </body>
</html>
