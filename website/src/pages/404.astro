---
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase } from "../lib/routing";
---

<SiteLayout
  title="Pagina niet gevonden — Robbe Wulgaert"
  description="De gevraagde pagina werd niet gevonden."
  lang="nl-BE"
  canonicalPath="/404"
  noindex={true}
>
  <main id="main-content" tabindex="-1" class="shell not-found">
    <p class="error-code" aria-hidden="true">404</p>
    <h1>Deze pagina bestaat niet.</h1>
    <p>Misschien is de link verouderd, of werd de pagina bewust niet meegenomen in de vernieuwde website.</p>
    <a class="button button--primary" href={withBase("/")}>Terug naar de startpagina</a>
  </main>
</SiteLayout>

<style>
  .not-found { display: grid; min-height: 68svh; align-content: center; justify-items: start; padding-block: var(--section-space); }
  .error-code { margin: 0; color: var(--color-brand); font-size: clamp(4rem, 18vw, 10rem); font-weight: 950; letter-spacing: -0.08em; line-height: 0.8; }
  h1 { max-width: 15ch; margin: 1.5rem 0 0; color: var(--color-ink); font-size: var(--font-size-h2); line-height: 1; }
  p:not(.error-code) { max-width: 42rem; color: var(--color-muted); font-size: var(--font-size-lead); }
</style>
