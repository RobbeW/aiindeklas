{
  "name": "robbewulgaert-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/run-astro.mjs dev",
    "build": "node scripts/run-astro.mjs build",
    "preview": "node scripts/run-astro.mjs preview",
    "check": "node scripts/run-astro.mjs check",
    "test": "node --test tests/unit/*.test.mjs",
    "crawl:source": "node scripts/discover-source.mjs",
    "verify:snapshots": "node scripts/verify-source-snapshots.mjs",
    "normalise:source": "node scripts/normalise-p5-source.mjs",
    "generate:route-map": "node scripts/generate-route-map.mjs",
    "migrate:content": "node scripts/migrate-content.mjs",
    "migrate:assets": "node scripts/download-assets.mjs",
    "migrate:p5": "pnpm normalise:source && pnpm generate:route-map && pnpm migrate:content",
    "cms:patch": "node scripts/cms-patch.mjs",
    "validate:cms": "node scripts/validate-cms-studio.mjs",
    "validate:p7": "node scripts/validate-p7.mjs",
    "lighthouse:p7": "node scripts/run-lighthouse-p7.mjs",
    "validate:content": "node scripts/validate-content-model.mjs",
    "validate:static-business": "node scripts/validate-static-business-pages.mjs",
    "validate:static-business:built": "node scripts/validate-static-business-pages.mjs --built=dist",
    "validate:static-business:built:project": "node scripts/validate-static-business-pages.mjs --built=dist --base=/aiindeklas/",
    "validate:articles": "node scripts/validate-articles.mjs",
    "validate:articles:built": "node scripts/validate-articles.mjs --built",
    "validate:articles:built:project": "node scripts/validate-articles.mjs --built --base /aiindeklas/",
    "p08:manifest": "node scripts/generate-p08-media-manifest.mjs",
    "p08:apply-video-deferrals": "node scripts/apply-p08-video-deferrals.mjs",
    "p08:validate": "node scripts/validate-p08-media.mjs",
    "p08:validate:built": "node scripts/validate-p08-media.mjs --built=dist",
    "p08:validate:built:project": "node scripts/validate-p08-media.mjs --built=dist --base=/aiindeklas/",
    "p09:inventory": "node scripts/generate-p09-dependencies.mjs",
    "p09:apply-youtube-labels": "node scripts/apply-p09-youtube-labels.mjs",
    "p09:validate": "node scripts/validate-p09.mjs",
    "p09:validate:built": "node scripts/validate-p09.mjs --built=dist",
    "p09:validate:built:project": "node scripts/validate-p09.mjs --built=dist --base=/aiindeklas/",
    "p10:responsive": "node scripts/validate-responsive.mjs",
    "p10:responsive:project": "node scripts/validate-responsive.mjs --project",
    "p11:accessibility": "node scripts/validate-accessibility.mjs",
    "p11:accessibility:project": "node scripts/validate-accessibility.mjs --project",
    "p12:crawl:root": "node scripts/crawl-seo-geo.mjs root",
    "p12:crawl:project": "node scripts/crawl-seo-geo.mjs project",
    "p13:report:root": "node scripts/validate-p13-discoverability.mjs root",
    "p13:report:project": "node scripts/validate-p13-discoverability.mjs project",
    "p13:validate:root": "node scripts/validate-p13-discoverability.mjs root",
    "p13:validate:project": "node scripts/validate-p13-discoverability.mjs project",
    "build:root": "node scripts/build-profile.mjs root",
    "build:project": "node scripts/build-profile.mjs project",
    "build:production-sim": "node scripts/build-profile.mjs production-sim",
    "p14:smoke": "node scripts/p14-pages-smoke.mjs",
    "p18:privacy": "node scripts/validate-p18-privacy.mjs",
    "p18:browser": "node scripts/p18-browser-smoke.mjs",
    "p19:validate": "node scripts/validate-p19-finder.mjs",
    "p19:browser": "node scripts/p19-browser-smoke.mjs",
    "quality": "pnpm generate:route-map && pnpm validate:content && pnpm test && pnpm check",
    "quality:local": "pnpm verify:snapshots && pnpm quality:p4",
    "quality:p4": "pnpm quality && pnpm build:root && pnpm build:project",
    "quality:p5": "pnpm verify:snapshots && pnpm migrate:p5 && pnpm validate:content && pnpm test && pnpm check && pnpm build:root && pnpm build:project",
    "quality:p6": "pnpm validate:content && pnpm test && pnpm check && pnpm build:root && pnpm build:project && pnpm validate:cms",
    "quality:p7": "pnpm verify:snapshots && pnpm validate:content && pnpm test && pnpm check && pnpm build:project && pnpm build:root && pnpm validate:cms && pnpm validate:p7 && pnpm lighthouse:p7"
  },
  "dependencies": {
    "@astrojs/check": "0.9.9",
    "@astrojs/markdown-remark": "7.2.1",
    "@astrojs/mdx": "7.0.3",
    "@astrojs/rss": "4.0.19",
    "astro": "7.0.9",
    "cheerio": "1.2.0",
    "sharp": "0.35.3",
    "turndown": "7.2.4",
    "typescript": "6.0.3",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "chrome-launcher": "^1.2.1",
    "lighthouse": "^13.4.0"
  }
}
