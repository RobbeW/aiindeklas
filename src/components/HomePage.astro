---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getImage } from "astro:assets";
import type { DocumentViewModel } from "../lib/content-view";

interface Props {
  content: DocumentViewModel;
  canonicalPath?: string;
}

const { content, canonicalPath = "/" } = Astro.props;
const socialImage = content.socialImage ? (await getImage({ src: content.socialImage })).src : null;
---

<SiteLayout
  title={`${content.title} — Robbe Wulgaert`}
  description={content.description}
  lang="nl-BE"
  canonicalPath={canonicalPath}
  noindex={content.noindex}
  alternatePath="/about"
  hasDirectTranslation={true}
  sourceHome={true}
  image={socialImage}
>
  <main id="main-content" tabindex="-1" data-content-collection={content.collection} data-content-id={content.id}>
    <section class="home-introduction" aria-label="Introductie">
      <div class="shell source-home"><slot /></div>
    </section>
  </main>
</SiteLayout>

<style>
  :global(body) { background: var(--color-surface); }

  .home-introduction { padding-block: clamp(2.5rem, 6vw, 5.75rem); }

  .source-home {
    width: min(calc(100% - (2 * var(--page-gutter))), 79.375rem);
    display: grid;
    gap: 1.4rem;
  }

  .source-home :global(h1) {
    max-width: none;
    margin: 0;
    color: var(--color-brand);
    font-size: clamp(3rem, 5vw, 4.1rem);
    font-weight: 900;
    letter-spacing: -0.055em;
    line-height: 0.98;
  }

  .source-home :global(p) {
    margin: 0;
    color: var(--color-brand-dark);
    font-size: clamp(1rem, 1.25vw, 1.1rem);
    line-height: 1.78;
  }

  .source-home :global(p > a:has(img)) {
    display: block;
    color: inherit;
  }

  .source-home :global(img) {
    width: 100%;
    border-radius: 0;
  }

  .source-home :global(p:nth-of-type(1) img) {
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .source-home :global(p:nth-of-type(4) img) {
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 50% center;
  }

  .source-home :global(.content-button-row) {
    width: 100%;
    margin: 0;
  }

  .source-home :global(.content-button) {
    width: 100%;
    display: flex;
    min-height: 5.25rem;
    align-items: center;
    justify-content: center;
    border: 2px solid var(--color-brand);
    color: var(--color-brand-dark);
    padding: 1rem;
    font-weight: 850;
    line-height: 1.3;
    text-align: center;
    text-decoration: none;
    transition: opacity 100ms linear;
  }

  .source-home :global(.content-button:hover) {
    opacity: 0.72;
  }

  @media (min-width: 56rem) {
    .source-home {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      column-gap: clamp(1rem, 2vw, 2.5rem);
      row-gap: 1.4rem;
      align-items: start;
    }

    .source-home :global(h1) { grid-column: 1; grid-row: 1; align-self: end; }
    .source-home :global(p:nth-of-type(1)) { grid-column: 2; grid-row: 1 / span 3; }
    .source-home :global(p:nth-of-type(2)) { grid-column: 1; grid-row: 2; }
    .source-home :global(p:nth-of-type(3)) { grid-column: 1; grid-row: 3; }
    .source-home :global(p:nth-of-type(4)) { grid-column: 1; grid-row: 4 / span 4; }
    .source-home :global(.content-button-row:nth-of-type(1)) { grid-column: 2; grid-row: 4; }
    .source-home :global(.content-button-row:nth-of-type(2)) { grid-column: 2; grid-row: 5; }
    .source-home :global(.content-button-row:nth-of-type(3)) { grid-column: 2; grid-row: 6; }
    .source-home :global(.content-button-row:nth-of-type(4)) { grid-column: 2; grid-row: 7; }

    .source-home :global(p:nth-of-type(4) img) { aspect-ratio: 0.72; }
    .source-home :global(.content-button) { min-height: 6.5rem; }
  }

  @media (max-width: 55.999rem) {
    .source-home :global(h1) { order: 1; }
    .source-home :global(p:nth-of-type(1)) { order: 2; }
    .source-home :global(p:nth-of-type(2)) { order: 3; }
    .source-home :global(p:nth-of-type(3)) { order: 4; }
    .source-home :global(p:nth-of-type(4)) { order: 5; margin-top: 0.6rem; }
    .source-home :global(.content-button-row) { order: 6; }
  }
</style>
