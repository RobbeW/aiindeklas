---
interface Props { lang?: "nl-BE" | "en"; }
const { lang = "nl-BE" } = Astro.props;
---

<aside class="preview-notice" aria-label={lang === "en" ? "Migration status" : "Migratiestatus"}>
  <span class="notice-dot" aria-hidden="true"></span>
  <p>
    <strong>{lang === "en" ? "Local build preview" : "Lokale bouwpreview"}</strong>
    {lang === "en"
      ? " — migrated source copy and media are available locally for review and are not published yet."
      : " — gemigreerde bronteksten en media staan lokaal klaar voor controle en zijn nog niet gepubliceerd."}
  </p>
</aside>

<style>
  .preview-notice {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--color-warning) 65%, var(--color-line));
    border-radius: var(--radius-brand);
    color: var(--color-text);
    background: color-mix(in srgb, var(--color-warning) 9%, var(--color-surface));
    padding: 0.9rem 1rem;
  }

  .preview-notice p { margin: 0; }
  .notice-dot { flex: 0 0 auto; width: 0.7rem; aspect-ratio: 1; border-radius: 50%; background: var(--color-warning); margin-top: 0.42rem; }
</style>
