---
import PageHero from "./PageHero.astro";
import PreviewNotice from "./PreviewNotice.astro";
import ContactEmailForm from "./ContactEmailForm.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import type { DocumentViewModel } from "../lib/content-view";
import { fitDescription } from "../lib/content-view";

interface Props {
  view: DocumentViewModel;
  socialImage?: string | null;
  alternatePath?: string | null;
}

const { view, socialImage = null, alternatePath = null } = Astro.props;
const articleSection = view.locale === "en" ? "Education" : "Onderwijs";
const seoTitle = view.collection === "articles"
  ? `${view.title} — ${articleSection} — Robbe Wulgaert`
  : `${view.title} — Robbe Wulgaert`;
const seoDescription = view.collection === "articles"
  ? fitDescription(`${view.title} (${articleSection}): ${view.description}`)
  : fitDescription(view.description);
---

<SiteLayout
  title={seoTitle}
  description={seoDescription}
  lang={view.locale}
  canonicalPath={view.canonicalPath}
  noindex={view.noindex}
  alternatePath={alternatePath}
  hasDirectTranslation={Boolean(alternatePath)}
  ogType={view.collection === "articles" ? "article" : "website"}
  publishedAt={view.publishedAt}
  modifiedAt={view.modifiedAt}
  image={socialImage}
>
  <main id="main-content" tabindex="-1" data-content-collection={view.collection} data-content-id={view.id}>
    <PageHero
      eyebrow={view.collection === "pages" ? view.locale === "en" ? "Page" : "Pagina" : view.collection}
      title={view.title}
      lead={view.description}
    />
    <section class="section shell content-grid" aria-labelledby="content-heading">
      {view.status !== "published" && <PreviewNotice lang={view.locale} />}
      {(["/boek", "/contact", "/contactinfo", "/verkoopsvoorwaarden"].includes(view.canonicalPath)) && (
        <aside class="business-review" data-verification="pending-live-verification-before-release" aria-label="Informatie ter controle">
          <strong>{view.locale === "en" ? "Source content requires review" : "Broninhoud ter controle"}</strong>
          <p>{view.locale === "en" ? "This page requires live verification before release. Its content is not confirmed as current." : "Deze pagina vereist live verificatie vóór publicatie. De inhoud is niet als actueel bevestigd."}</p>
          {view.canonicalPath === "/verkoopsvoorwaarden" && <p>{view.locale === "en" ? "" : "Deze verkoopsvoorwaarden zijn niet juridisch nagekeken."}</p>}
        </aside>
      )}
      <h2 id="content-heading" class="visually-hidden">
        {view.locale === "en" ? "Page content" : "Pagina-inhoud"}
      </h2>
      {(["/contact", "/contactinfo"].includes(view.canonicalPath)) && <ContactEmailForm lang={view.locale === "en" ? "en" : "nl-BE"} />}
      <div class="prose"><slot /></div>
    </section>
  </main>
</SiteLayout>

<style>
  .content-grid { display: grid; gap: 2rem; }
  .business-review { max-width: var(--content-readable); padding: 1rem 1.25rem; border-left: 3px solid var(--color-brand); background: var(--color-surface); }
  .prose { max-width: var(--content-readable); font-size: 1.08rem; }
  .prose :global(h2) { margin-top: 2.5rem; color: var(--color-ink); font-size: 1.75rem; }
  .prose :global(a) { text-underline-offset: 0.22em; }
  .prose :global(p:first-child) { margin-top: 0; }
</style>
