---
import PageHero from "./PageHero.astro";
import PreviewNotice from "./PreviewNotice.astro";
import SiteLayout from "../layouts/SiteLayout.astro";
import { withBase, type SiteLocale } from "../lib/routing";
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

export interface ListingCard {
  id: string;
  title: string;
  description: string;
  href: string;
  meta?: string | null;
  external?: boolean;
  image?: ImageMetadata | null;
}

interface Props {
  title: string;
  seoTitle?: string;
  description: string;
  locale: SiteLocale;
  canonicalPath: string;
  eyebrow: string;
  cards: ListingCard[];
  alternatePath?: string | null;
}

const {
  title,
  seoTitle = title,
  description,
  locale,
  canonicalPath,
  eyebrow,
  cards,
  alternatePath = null
} = Astro.props;
const hrefFor = (card: ListingCard) => card.external ? card.href : withBase(card.href);
---

<SiteLayout
  title={`${seoTitle} — Robbe Wulgaert`}
  description={description}
  lang={locale}
  canonicalPath={canonicalPath}
  noindex={true}
  alternatePath={alternatePath}
  hasDirectTranslation={Boolean(alternatePath)}
>
  <main id="main-content" tabindex="-1">
    <PageHero eyebrow={eyebrow} title={title} lead={description} />
    <section class="section shell listing-layout" aria-labelledby="listing-heading">
      <PreviewNotice lang={locale} />
      <div class="intro prose"><slot /></div>
      <div class="listing-header">
        <h2 id="listing-heading" class="section-heading">
          {locale === "en" ? `${cards.length} entries` : `${cards.length} items`}
        </h2>
      </div>
      {cards.length > 0 ? (
        <div class="listing-grid">
          {cards.map((card) => (
            <article class:list={["listing-card", { "listing-card--with-image": Boolean(card.image) }]} id={card.id}>
              {card.image && (
                <a class="listing-image" href={hrefFor(card)} aria-label={card.title}>
                  <Image
                    src={card.image}
                    alt=""
                    widths={[320, 640, 960]}
                    sizes="(max-width: 42rem) 100vw, 32vw"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
              )}
              <div class="listing-copy">
                {card.meta && <p class="listing-meta">{card.meta}</p>}
                <h3><a href={hrefFor(card)} target={card.external ? "_blank" : undefined} rel={card.external ? "noreferrer" : undefined}>{card.title}</a></h3>
                <p>{card.description}</p>
              </div>
            </article>
          ))}
        </div>
      ) : (
        <p class="empty-state">{locale === "en" ? "No matching articles were present in the source archive." : "Er stonden geen overeenkomende artikels in het bronarchief."}</p>
      )}
    </section>
  </main>
</SiteLayout>

<style>
  .listing-layout { display: grid; gap: 2.25rem; }
  .intro:empty { display: none; }
  .prose { max-width: var(--content-readable); font-size: 1.06rem; }
  .prose :global(img) { border-radius: var(--radius-card); }
  .listing-header { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
  .listing-grid { display: grid; gap: 1rem; }
  .listing-card { overflow: hidden; border: 1px solid var(--color-line); border-radius: var(--radius-card); background: var(--color-surface); padding: clamp(1.25rem, 3vw, 1.8rem); box-shadow: var(--shadow-card); }
  .listing-card--with-image { display: grid; grid-template-columns: minmax(11rem, 0.72fr) minmax(0, 1.6fr); padding: 0; }
  .listing-image { min-height: 12rem; overflow: hidden; background: var(--color-brand-soft); }
  .listing-image img { width: 100%; height: 100%; object-fit: cover; transition: transform var(--motion-medium) var(--ease-standard); }
  .listing-image:hover img { transform: scale(1.025); }
  .listing-copy { align-self: center; padding: clamp(1.25rem, 3vw, 1.8rem); }
  .listing-card h3 { margin: 0; color: var(--color-ink); font-size: clamp(1.15rem, 3vw, 1.4rem); }
  .listing-card h3 a { color: inherit; text-decoration-thickness: 0.09em; text-underline-offset: 0.18em; }
  .listing-copy > p:last-child { max-width: 65ch; margin-bottom: 0; color: var(--color-muted); }
  .listing-meta { margin: 0 0 0.6rem; color: var(--color-brand); font-size: 0.83rem; font-weight: 850; letter-spacing: 0.04em; text-transform: uppercase; }
  .empty-state { border: 1px dashed var(--color-line); border-radius: var(--radius-card); padding: 1.5rem; color: var(--color-muted); }
  @media (max-width: 42rem) {
    .listing-card--with-image { grid-template-columns: 1fr; }
    .listing-image { min-height: 0; aspect-ratio: 16 / 9; }
  }
</style>
